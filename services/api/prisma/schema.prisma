generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum TenantStatus {
  PENDING_VERIFICATION
  ACTIVE
  SUSPENDED
  ARCHIVED
}

enum UserStatus {
  INVITED
  PENDING_VERIFICATION
  ACTIVE
  SUSPENDED

  /// Soft-deactivated: cannot login (distinct from SUSPENDED).
  INACTIVE
}

enum OAuthProvider {
  GOOGLE
  MICROSOFT
}

enum OAuthExchangeTicketKind {
  SESSION
  ONBOARDING
}

enum SmsSupportContactSource {
  OWNER
  MANAGER
}

enum LoanStatus {
  DRAFT
  SUBMITTED
  APPROVED
  PARTIALLY_DISBURSED
  REJECTED
  DISBURSED
  CURRENT
  IN_ARREARS
  RESTRUCTURED
  WRITTEN_OFF
  CLOSED
}

enum LoanApplicationStatus {
  DRAFT
  VERIFIED
  SUBMITTED
  REJECTED
  WITHDRAWN
}

enum LoanApplicationMediaType {
  PASSPORT
  NIN_FRONT
  NIN_BACK
  GUARANTOR_NIN_FRONT
  GUARANTOR_NIN_BACK
  COLLATERAL_DOC
  SUPPORTING_DOC
  OTHER_DOC
  SIGNATURE_APPLICANT
  SIGNATURE_GUARANTOR
  SIGNATURE_OFFICER
}

enum LoanApplicationSignerRole {
  APPLICANT
  GUARANTOR
  OFFICER
}

/// Applicant gender for KYC / Smile ID (mapped to M/F on verify).
enum ApplicantGender {
  MALE
  FEMALE
  OTHER
}

enum ModuleStatus {
  ENABLED
  TRIAL
  DISABLED
}

enum OutboxStatus {
  PENDING
  PROCESSING
  PUBLISHED
  FAILED
}

enum OtpChannel {
  EMAIL
  PHONE
}

enum OtpPurpose {
  WORKSPACE_REGISTRATION
  EMPLOYEE_INVITATION
  PASSWORD_RESET
}

enum RepaymentMethod {
  CASH
  MOBILE_MONEY
  BANK_TRANSFER
  OTHER
}

enum RepaymentCorrectionRequestStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum LoanDisbursementSource {
  ASSIGNED_FLOAT
  COLLECTED_REPAYMENTS
  MIXED_CASH
}

enum PaymentGatewayProvider {
  FLUTTERWAVE
}

enum PaymentGatewayIntentStatus {
  PENDING
  SUCCESSFUL
  FAILED
  CANCELLED
  REVERSED
}

enum BranchOperationStatus {
  OPEN
  CLOSING
  CLOSED
}

enum BranchOperationExpenseCategory {
  TRANSPORT
  FUEL
  MEALS
  AIRTIME
  MOBILE_MONEY_CHARGES
  STATIONERY
  REPAIRS
  UTILITIES
  OTHER
}

enum BranchOperationExpensePaidFrom {
  BRANCH_CASH
  AGENT_FLOAT
}

enum BranchOperationReportStatus {
  MANAGER_REVIEW
  SENT_TO_OWNER
  OWNER_APPROVED
  RETURNED_TO_MANAGER
}

/// When repayments begin relative to loan go-live (submit / disbursement).
/// Anchor = disbursedAt ?? approvedAt ?? submittedAt ?? createdAt.
enum PaymentStartPolicyType {
  SAME_DAY
  NEXT_DAY
  AFTER_N_DAYS
}

/// Interest pricing model for loan type templates.
enum LoanInterestType {
  FLAT
  REDUCING_BALANCE
  COMPOUND
}

enum LoanProcessingFeeType {
  PERCENTAGE
  FIXED
}

enum LoanTermUnit {
  DAYS
  WEEKS
  MONTHS

  /// Kept for backward compatibility; UI offers Days / Weeks / Month(s) only.
  YEARS
}

enum LoanRepaymentFrequency {
  DAILY
  WEEKLY
  BIWEEKLY
  MONTHLY
  LUMP_SUM
}

enum BorrowerListType {
  BLACKLISTED
  WATCHLIST
}

enum CustomerVoidDisposition {
  BLACKLISTED
  WARNING
}

enum SubscriptionInterval {
  MONTHLY
  THREE_MONTHS
  SIX_MONTHS
}

enum BranchSubscriptionStatus {
  TRIAL
  ACTIVE
  GRACE
  PAST_DUE
  LOCKED
}

enum SubscriptionPaymentStatus {
  PENDING
  COMPLETED
  FAILED
  CANCELLED
  REVERSED
}

enum SmsBundleStatus {
  ACTIVE
  INACTIVE
  ARCHIVED
}

enum SmsPurchaseStatus {
  PAYMENT_PENDING
  AWAITING_PAYMENT
  PAYMENT_CONFIRMED
  CREDIT_PROCESSING
  CREDITED
  PAYMENT_FAILED
  CANCELLED_BY_USER
  PAYMENT_MISMATCH
  MANUAL_REVIEW
  EXPIRED
  REFUNDED
  REVERSED
}

enum SmsWalletLedgerEntryType {
  BUNDLE_PURCHASE
  GRANT
  RESERVE
  RELEASE
  DEBIT_CONFIRMED
  ADJUSTMENT
  REFUND
}

enum SmsWalletLedgerDirection {
  CREDIT
  DEBIT
}

enum SmsMessageStatus {
  PENDING_VALIDATION
  RESERVED

  /// Provider accepted the submit; debit settled. Not the same as handset delivery.
  PROVIDER_ACCEPTED

  SENT
  FAILED_VALIDATION
  FAILED_INSUFFICIENT_CREDITS
  BLOCKED_PROVIDER_UNAVAILABLE
  PROVIDER_FAILED

  /// Immediate provider response was uncertain; reservation held pending reconciliation.
  PROVIDER_UNCERTAIN

  RELEASED
}

enum SmsDeliveryStatus {
  NOT_APPLICABLE
  PENDING
  DELIVERED
  FAILED
  UNKNOWN
}

enum SmsCallbackProcessingStatus {
  RECEIVED
  PROCESSING
  PROCESSED
  IGNORED
  FAILED
}

enum LoanReminderBatchStatus {
  QUEUED
  PROCESSING
  COMPLETED
  PARTIAL
  FAILED
}

enum LoanReminderItemStatus {
  QUEUED
  SENDING
  SENT
  FAILED
  SKIPPED_NO_CREDIT
  SKIPPED_NO_PHONE
  SKIPPED_ALREADY_SENT
}

enum CashShortageSource {
  AGENT_FLOAT_RETURN
  BRANCH_CLOSE
  MANUAL
}

enum CashShortageReason {
  CASH_NOT_RETURNED
  COLLECTION_NOT_ACCOUNTED_FOR
  PROCESSING_FEE_NOT_ACCOUNTED_FOR
  FLOAT_NOT_ACCOUNTED_FOR
  OTHER
}

enum CashShortageStatus {
  OPEN
  PARTIALLY_PAID
  CLEARED
}

enum CashShortagePaymentMethod {
  CASH
  SALARY_DEDUCTION
  OTHER
}

enum EmployeeStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum SalaryPaymentMethod {
  CASH
  MOBILE_MONEY
  BANK_TRANSFER
  OTHER
}

enum PushPlatform {
  WEB
  ANDROID
  IOS
}

enum ControlCenterAdminStatus {
  ACTIVE
  SUSPENDED
}

enum ControlCenterMessageChannel {
  EMAIL
  SMS
}

enum ControlCenterMessageStatus {
  SENT
  FAILED
  SKIPPED
}

enum MarketingCampaignStatus {
  DRAFT
  ACTIVE
  PAUSED
  ARCHIVED
}

enum MarketingCampaignPlacement {
  MOBILE_HEADER
}

enum MarketingCampaignAudience {
  ALL_USERS
  TENANT_USERS
  BRANCH_USERS
  TENANT_OWNERS
  ROLE_USERS
  SELECTED_USERS
}

enum MarketingCampaignMediaType {
  NONE
  IMAGE
  VIDEO
}

enum ControlledFeatureScope {
  TENANT
  BRANCH
}

model Tenant {
  id                 String       @id @default(uuid()) @db.Uuid
  name               String
  registrationNumber String?      @map("registration_number")
  country            String
  currency           String
  status             TenantStatus @default(PENDING_VERIFICATION)
  storagePrefix      String?      @map("storage_prefix")
  createdAt          DateTime     @default(now()) @map("created_at")
  updatedAt          DateTime     @updatedAt @map("updated_at")

  branches                    Branch[]
  departments                 Department[]
  users                       User[]
  roles                       Role[]
  permissions                 Permission[]
  customers                   Customer[]
  loans                       Loan[]
  loanDisbursements           LoanDisbursement[]
  repayments                  Repayment[]
  repaymentCorrectionRequests RepaymentCorrectionRequest[]
  paymentGatewayIntents       PaymentGatewayIntent[]
  clientWallets               ClientWallet[]
  loanApplications            LoanApplication[]
  loanRateOptions             LoanRateOption[]
  loanPeriodOptions           LoanPeriodOption[]
  loanProductTemplates        LoanProductTemplate[]
  loanPaymentStartPolicies    LoanPaymentStartPolicy[]
  loanFinePolicies            LoanFinePolicy[]
  loanFines                   LoanFine[]
  enabledModules              TenantModule[]
  auditLogs                   AuditLog[]
  outboxEvents                OutboxEvent[]
  otpChallenges               OtpChallenge[]
  agentDailyFloats            AgentDailyFloat[]

  branchDailyOperations   BranchDailyOperation[]
  branchOperationExpenses BranchOperationExpense[]
  branchOperationTopUps   BranchOperationTopUp[]
  branchOperationReports  BranchOperationReport[]

  operationReconciliations BranchOperationReconciliation[]
  operationCashCounts      BranchOperationCashCount[]

  devicePushTokens           DevicePushToken[]
  authSessions               AuthSession[]
  billing                    TenantBilling?
  branchSubscriptions        BranchSubscription[]
  subscriptionPayments       SubscriptionPayment[]
  branchSmsWallets           BranchSmsWallet[]
  smsCreditPayments          SmsCreditPayment[]
  smsUsageLogs               SmsUsageLog[]
  smsPurchases               SmsPurchase[]
  smsWalletLedgers           SmsWalletLedger[]
  smsMessages                SmsMessage[]
  smsCallbackEvents          SmsCallbackEvent[]
  smsProviderRequestLogs     SmsProviderRequestLog[]
  loanReminderBatches        LoanReminderBatch[]
  loanReminderItems          LoanReminderItem[]
  cashShortages              CashShortage[]
  cashShortagePayments       CashShortagePayment[]
  employees                  Employee[]
  salaryPayments             SalaryPayment[]
  smsNotificationSettings    TenantSmsNotificationSettings?
  subscriptionPriceOverrides SubscriptionPriceOverride[]
  controlCenterMessageLogs   ControlCenterMessageLog[]
  marketingCampaigns         MarketingCampaign[]
  controlledFeatureAccess    ControlledFeatureAccess[]
  appReleaseTargets          AppReleaseTenant[]

  @@map("tenants")
}

model Branch {
  id           String   @id @default(uuid()) @db.Uuid
  tenantId     String   @map("tenant_id") @db.Uuid
  name         String
  address      String
  gpsLatitude  Decimal? @map("gps_latitude") @db.Decimal(10, 7)
  gpsLongitude Decimal? @map("gps_longitude") @db.Decimal(10, 7)
  phone        String?
  workingHours Json?    @map("working_hours")
  agentFieldExpensesEnabled Boolean @default(true) @map("agent_field_expenses_enabled")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  tenant                      Tenant                       @relation(fields: [tenantId], references: [id])
  users                       User[]
  customers                   Customer[]
  loans                       Loan[]
  loanDisbursements           LoanDisbursement[]
  repayments                  Repayment[]
  repaymentCorrectionRequests RepaymentCorrectionRequest[]
  clientWallets               ClientWallet[]
  loanApplications            LoanApplication[]
  loanRateOptions             LoanRateOption[]
  loanPeriodOptions           LoanPeriodOption[]
  loanProductTemplates        LoanProductTemplate[]
  loanPaymentStartPolicies    LoanPaymentStartPolicy[]
  loanFinePolicies            LoanFinePolicy[]
  loanFines                   LoanFine[]
  agentDailyFloats            AgentDailyFloat[]

  dailyOperations          BranchDailyOperation[]
  operationExpenses        BranchOperationExpense[]
  operationTopUps          BranchOperationTopUp[]
  operationReports         BranchOperationReport[]
  operationReconciliations BranchOperationReconciliation[]

  subscription               BranchSubscription?
  subscriptionPayments       SubscriptionPayment[]
  smsWallet                  BranchSmsWallet?
  smsCreditPayments          SmsCreditPayment[]
  smsUsageLogs               SmsUsageLog[]
  smsPurchases               SmsPurchase[]
  smsWalletLedgers           SmsWalletLedger[]
  smsMessages                SmsMessage[]
  smsProviderRequestLogs     SmsProviderRequestLog[]
  loanReminderBatches        LoanReminderBatch[]
  loanReminderItems          LoanReminderItem[]
  cashShortages              CashShortage[]
  employees                  Employee[]
  salaryPayments             SalaryPayment[]
  subscriptionPriceOverrides SubscriptionPriceOverride[]
  controlCenterMessageLogs   ControlCenterMessageLog[]
  marketingCampaigns         MarketingCampaign[]
  controlledFeatureAccess    ControlledFeatureAccess[]

  @@unique([tenantId, name])
  @@index([tenantId, name])
  @@map("branches")
}

model TenantSmsNotificationSettings {
  id                         String   @id @default(uuid()) @db.Uuid
  tenantId                   String   @unique @map("tenant_id") @db.Uuid
  enabled                    Boolean  @default(true)
  loanRecordedEnabled        Boolean  @default(true) @map("loan_recorded_enabled")
  paymentConfirmationEnabled Boolean  @default(true) @map("payment_confirmation_enabled")
  paymentReminderEnabled     Boolean  @default(true) @map("payment_reminder_enabled")
  overdueNoticeEnabled       Boolean  @default(true) @map("overdue_notice_enabled")
  supportContactSource       SmsSupportContactSource @default(MANAGER) @map("support_contact_source")
  supportContactLocked       Boolean  @default(false) @map("support_contact_locked")
  updatedByUserId            String?  @map("updated_by_user_id") @db.Uuid
  createdAt                  DateTime @default(now()) @map("created_at")
  updatedAt                  DateTime @updatedAt @map("updated_at")

  tenant    Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  updatedBy User?  @relation("SmsNotificationSettingsUpdatedBy", fields: [updatedByUserId], references: [id], onDelete: SetNull)

  @@map("tenant_sms_notification_settings")
}

model LoanProductTemplate {
  id                       String                 @id @default(uuid()) @db.Uuid
  tenantId                 String                 @map("tenant_id") @db.Uuid
  branchId                 String?                @map("branch_id") @db.Uuid
  name                     String
  description              String?
  interestRatePercent      Decimal                @map("interest_rate_percent") @db.Decimal(8, 4)
  interestType             LoanInterestType       @default(FLAT) @map("interest_type")
  termValue                Int                    @map("term_value")
  termUnit                 LoanTermUnit           @map("term_unit")
  repaymentFrequency       LoanRepaymentFrequency @map("repayment_frequency")
  processingFeeType        LoanProcessingFeeType  @default(PERCENTAGE) @map("processing_fee_type")
  processingFeePercent     Decimal                @map("processing_fee_percent") @db.Decimal(8, 4)
  processingFeeFixedAmount Decimal?               @map("processing_fee_fixed_amount") @db.Decimal(18, 2)
  penaltyRatePercent       Decimal                @map("penalty_rate_percent") @db.Decimal(8, 4)
  finePeriodDays           Int                    @default(10) @map("fine_period_days")
  paymentStartPolicy       PaymentStartPolicyType @default(NEXT_DAY) @map("payment_start_policy")
  paymentStartDelayDays    Int?                   @map("payment_start_delay_days")
  allowAgentDatePick       Boolean                @default(false) @map("allow_agent_date_pick")
  minLoanAmount            Decimal?               @map("min_loan_amount") @db.Decimal(18, 2)
  maxLoanAmount            Decimal?               @map("max_loan_amount") @db.Decimal(18, 2)
  notes                    String?
  isActive                 Boolean                @default(true) @map("is_active")
  sortOrder                Int                    @default(0) @map("sort_order")
  createdAt                DateTime               @default(now()) @map("created_at")
  updatedAt                DateTime               @updatedAt @map("updated_at")

  tenant       Tenant            @relation(fields: [tenantId], references: [id])
  branch       Branch?           @relation(fields: [branchId], references: [id])
  applications LoanApplication[]

  @@index([tenantId, branchId, isActive])
  @@index([tenantId, isActive, sortOrder])
  @@map("loan_product_templates")
}

model LoanRateOption {
  id                  String   @id @default(uuid()) @db.Uuid
  tenantId            String   @map("tenant_id") @db.Uuid
  branchId            String?  @map("branch_id") @db.Uuid
  label               String
  interestRatePercent Decimal  @map("interest_rate_percent") @db.Decimal(8, 4)
  isActive            Boolean  @default(true) @map("is_active")
  sortOrder           Int      @default(0) @map("sort_order")
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")

  tenant Tenant  @relation(fields: [tenantId], references: [id])
  branch Branch? @relation(fields: [branchId], references: [id])

  @@index([tenantId, branchId, isActive])
  @@index([tenantId, isActive, sortOrder])
  @@map("loan_rate_options")
}

model LoanPeriodOption {
  id           String   @id @default(uuid()) @db.Uuid
  tenantId     String   @map("tenant_id") @db.Uuid
  branchId     String?  @map("branch_id") @db.Uuid
  label        String
  durationDays Int      @map("duration_days")
  isActive     Boolean  @default(true) @map("is_active")
  sortOrder    Int      @default(0) @map("sort_order")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  tenant Tenant  @relation(fields: [tenantId], references: [id])
  branch Branch? @relation(fields: [branchId], references: [id])

  @@index([tenantId, branchId, isActive])
  @@index([tenantId, isActive, sortOrder])
  @@map("loan_period_options")
}

model LoanPaymentStartPolicy {
  id                 String                 @id @default(uuid()) @db.Uuid
  tenantId           String                 @map("tenant_id") @db.Uuid
  branchId           String?                @map("branch_id") @db.Uuid
  policyType         PaymentStartPolicyType @map("policy_type")
  afterDays          Int?                   @map("after_days")
  allowAgentDatePick Boolean                @default(false) @map("allow_agent_date_pick")
  isActive           Boolean                @default(true) @map("is_active")
  createdAt          DateTime               @default(now()) @map("created_at")
  updatedAt          DateTime               @updatedAt @map("updated_at")

  tenant Tenant  @relation(fields: [tenantId], references: [id])
  branch Branch? @relation(fields: [branchId], references: [id])

  @@index([tenantId, branchId, isActive])
  @@index([tenantId, isActive])
  @@map("loan_payment_start_policies")
}

model LoanFinePolicy {
  id             String   @id @default(uuid()) @db.Uuid
  tenantId       String   @map("tenant_id") @db.Uuid
  branchId       String?  @map("branch_id") @db.Uuid
  finePeriodDays Int      @map("fine_period_days")
  fineAmount     Decimal  @map("fine_amount") @db.Decimal(18, 2)
  isActive       Boolean  @default(true) @map("is_active")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  tenant Tenant  @relation(fields: [tenantId], references: [id])
  branch Branch? @relation(fields: [branchId], references: [id])

  @@index([tenantId, branchId, isActive])
  @@index([tenantId, isActive])
  @@map("loan_fine_policies")
}

model LoanFine {
  id          String   @id @default(uuid()) @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  branchId    String   @map("branch_id") @db.Uuid
  loanId      String   @map("loan_id") @db.Uuid
  periodIndex Int      @map("period_index")
  amount      Decimal  @db.Decimal(18, 2)
  dueAt       DateTime @map("due_at")
  appliedAt   DateTime @default(now()) @map("applied_at")
  createdAt   DateTime @default(now()) @map("created_at")

  tenant Tenant @relation(fields: [tenantId], references: [id])
  branch Branch @relation(fields: [branchId], references: [id])
  loan   Loan   @relation(fields: [loanId], references: [id])

  @@unique([loanId, periodIndex])
  @@index([tenantId, loanId])
  @@index([tenantId, appliedAt])
  @@map("loan_fines")
}

model Department {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  name      String
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id])
  users  User[]

  @@unique([tenantId, name])
  @@map("departments")
}

model User {
  id                     String     @id @default(uuid()) @db.Uuid
  tenantId               String     @map("tenant_id") @db.Uuid
  branchId               String?    @map("branch_id") @db.Uuid
  departmentId           String?    @map("department_id") @db.Uuid
  email                  String     @unique
  phone                  String?    @unique
  publicId               String?    @unique @map("public_id")
  displayName            String     @map("display_name")
  passwordHash           String?    @map("password_hash")
  profilePhotoStorageKey String?    @map("profile_photo_storage_key")
  profilePhotoMimeType   String?    @map("profile_photo_mime_type")
  profilePhotoUpdatedAt  DateTime?  @map("profile_photo_updated_at")
  emailVerified          Boolean    @default(false) @map("email_verified")
  phoneVerified          Boolean    @default(false) @map("phone_verified")
  status                 UserStatus @default(INVITED)
  suspensionReason       String?    @map("suspension_reason")
  createdAt              DateTime   @default(now()) @map("created_at")
  updatedAt              DateTime   @updatedAt @map("updated_at")

  tenant     Tenant      @relation(fields: [tenantId], references: [id])
  branch     Branch?     @relation(fields: [branchId], references: [id])
  department Department? @relation(fields: [departmentId], references: [id])

  roles                       UserRole[]
  auditLogs                   AuditLog[]
  otpChallenges               OtpChallenge[]
  loanApplications            LoanApplication[]            @relation("LoanApplicationOfficer")
  loanDisbursements           LoanDisbursement[]           @relation("LoanDisbursementRecorder")
  repaymentsRecorded          Repayment[]                  @relation("RepaymentRecorder")
  repaymentCorrectionRequests RepaymentCorrectionRequest[] @relation("RepaymentCorrectionRequester")
  repaymentCorrectionReviews  RepaymentCorrectionRequest[] @relation("RepaymentCorrectionReviewer")
  repaymentCorrectionsApplied RepaymentCorrectionRequest[] @relation("RepaymentCorrectionApplier")
  dailyFloats                 AgentDailyFloat[]            @relation("AgentDailyFloatAgent")
  dailyFloatsRecorded         AgentDailyFloat[]            @relation("AgentDailyFloatRecorder")
  dailyFloatsReturned         AgentDailyFloat[]            @relation("AgentDailyFloatReturnedBy")

  branchOperationsOpened BranchDailyOperation[] @relation("BranchDailyOperationOpenedBy")
  branchOperationsClosed BranchDailyOperation[] @relation("BranchDailyOperationClosedBy")

  operationReconciliationsStarted BranchOperationReconciliation[] @relation("BranchOperationReconciliationStartedBy")
  operationReconciliationsUpdated BranchOperationReconciliation[] @relation("BranchOperationReconciliationUpdatedBy")
  operationCashCountsRecorded     BranchOperationCashCount[]      @relation("BranchOperationCashCountRecordedBy")

  operationExpensesRecorded     BranchOperationExpense[] @relation("BranchOperationExpenseRecordedBy")
  operationExpensesApproved     BranchOperationExpense[] @relation("BranchOperationExpenseApprovedBy")
  operationExpensesAsAgent      BranchOperationExpense[] @relation("BranchOperationExpenseAgent")
  operationTopUpsRecorded       BranchOperationTopUp[]   @relation("BranchOperationTopUpRecordedBy")
  operationReportsReviewed      BranchOperationReport[]  @relation("BranchOperationReportReviewedBy")
  operationReportsApproved      BranchOperationReport[]  @relation("BranchOperationReportApprovedBy")
  operationReportsReturned      BranchOperationReport[]  @relation("BranchOperationReportReturnedBy")
  voidedBranchOperationExpenses BranchOperationExpense[] @relation("BranchOperationExpenseVoidedBy")

  devicePushTokens    DevicePushToken[]
  authSessions        AuthSession[]
  oauthAccounts       UserOAuthAccount[]
  loanReminderBatches LoanReminderBatch[] @relation("LoanReminderBatchCreatedBy")

  cashShortagesResponsible CashShortage[]        @relation("CashShortageResponsible")
  cashShortagesCreated     CashShortage[]        @relation("CashShortageCreatedBy")
  cashShortagePayments     CashShortagePayment[] @relation("CashShortagePaymentRecordedBy")
  employeeProfile          Employee?             @relation("EmployeeUser")
  employeesCreated         Employee[]            @relation("EmployeeCreatedBy")
  salaryPaymentsRecorded   SalaryPayment[]       @relation("SalaryPaymentRecordedBy")
  customersVoided          Customer[]            @relation("CustomerVoidedBy")

  smsNotificationSettingsUpdated TenantSmsNotificationSettings[] @relation("SmsNotificationSettingsUpdatedBy")

  @@unique([tenantId, email])
  @@unique([tenantId, phone])
  @@index([tenantId, branchId])
  @@map("users")
}

model UserOAuthAccount {
  id              String        @id @default(uuid()) @db.Uuid
  userId          String        @map("user_id") @db.Uuid
  provider        OAuthProvider
  providerSubject String        @map("provider_subject")
  email           String
  displayName     String?       @map("display_name")
  rawProfile      Json?         @map("raw_profile")
  linkedAt        DateTime      @default(now()) @map("linked_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerSubject])
  @@index([userId])
  @@index([email])
  @@map("user_oauth_accounts")
}

model OAuthExchangeTicket {
  id         String                  @id @default(uuid()) @db.Uuid
  kind       OAuthExchangeTicketKind
  payload    Json
  expiresAt  DateTime                @map("expires_at")
  consumedAt DateTime?               @map("consumed_at")
  createdAt  DateTime                @default(now()) @map("created_at")

  @@index([expiresAt])
  @@map("oauth_exchange_tickets")
}

model AuthSession {
