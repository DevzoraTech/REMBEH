model Employee {
  id                   String               @id @default(uuid()) @db.Uuid
  tenantId             String               @map("tenant_id") @db.Uuid
  branchId             String?              @map("branch_id") @db.Uuid
  userId               String?              @unique @map("user_id") @db.Uuid
  fullName             String               @map("full_name")
  phone                String?
  email                String?
  ninNumber            String?              @map("nin_number")
  roleName             String?              @map("role_name")
  status               EmployeeStatus       @default(ACTIVE)
  monthlySalary        Decimal              @default(0) @map("monthly_salary") @db.Decimal(18, 2)
  dateJoined           DateTime             @map("date_joined") @db.Date
  paymentMethod        SalaryPaymentMethod? @map("payment_method")
  paymentProvider      String?              @map("payment_provider")
  paymentAccountName   String?              @map("payment_account_name")
  paymentAccountNumber String?              @map("payment_account_number")
  notes                String?
