model SmsMessage {
  id                   String            @id @default(uuid()) @db.Uuid
  tenantId             String            @map("tenant_id") @db.Uuid
  branchId             String            @map("branch_id") @db.Uuid
  walletId             String            @map("wallet_id") @db.Uuid
  recipientId          String?           @map("recipient_id")
  recipientPhone       String            @map("recipient_phone")
  messageType          String            @map("message_type")
  messageBody          String            @map("message_body") @db.Text
  triggerSource        String            @map("trigger_source")
  triggerReferenceId   String?           @map("trigger_reference_id")
  requestedByUserId    String?           @map("requested_by_user_id") @db.Uuid
  status               SmsMessageStatus  @default(PENDING_VALIDATION)
  deliveryStatus       SmsDeliveryStatus @default(NOT_APPLICABLE) @map("delivery_status")
  encodingType         String?           @map("encoding_type")
  characterCount       Int?              @map("character_count")
  segmentsRequired     Int?              @map("segments_required")
  idempotencyKey       String?           @unique @map("idempotency_key")
  parentMessageId      String?           @map("parent_message_id") @db.Uuid
  attemptNumber        Int               @default(1) @map("attempt_number")
  providerMessageId    String?           @map("provider_message_id")
  failureReason        String?           @map("failure_reason")
  reservationExpiresAt DateTime?         @map("reservation_expires_at")
  createdAt            DateTime          @default(now()) @map("created_at")
  updatedAt            DateTime          @updatedAt @map("updated_at")
  sentAt               DateTime?         @map("sent_at")
  deliveredAt          DateTime?         @map("delivered_at")

  tenant Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch Branch          @relation(fields: [branchId], references: [id], onDelete: Cascade)
  wallet BranchSmsWallet @relation(fields: [walletId], references: [id], onDelete: Cascade)

  parentMessage SmsMessage?  @relation("SmsMessageRetries", fields: [parentMessageId], references: [id], onDelete: SetNull)
  retryAttempts SmsMessage[] @relation("SmsMessageRetries")

  providerRequestLogs SmsProviderRequestLog[]

  @@index([tenantId, branchId, createdAt])
  @@index([status, createdAt])
  @@index([status, reservationExpiresAt])
  @@index([parentMessageId])
  @@index([messageType, triggerReferenceId])
  @@map("sms_messages")
}

