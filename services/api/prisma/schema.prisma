model SmsPurchase {
  id                     String            @id @default(uuid()) @db.Uuid
  tenantId               String            @map("tenant_id") @db.Uuid
  branchId               String            @map("branch_id") @db.Uuid
  walletId               String            @map("wallet_id") @db.Uuid
  bundleId               String            @map("bundle_id") @db.Uuid
  bundleVersion          Int               @map("bundle_version")
  bundleNameSnapshot     String            @map("bundle_name_snapshot")
  initiatedByUserId      String            @map("initiated_by_user_id") @db.Uuid
  amountExpected         Int               @map("amount_expected")
  currency               String            @default("UGX")
  smsUnitsExpected       Int               @map("sms_units_expected")
  merchantReference      String            @unique @map("merchant_reference")
  pesapalOrderTrackingId String?           @map("pesapal_order_tracking_id")
  externalTransactionId  String?           @map("external_transaction_id")
  status                 SmsPurchaseStatus @default(PAYMENT_PENDING)
  rawPayload             Json?             @map("raw_payload")
  creditedAt             DateTime?         @map("credited_at")
  createdAt              DateTime          @default(now()) @map("created_at")
  updatedAt              DateTime          @updatedAt @map("updated_at")
  expiresAt              DateTime          @map("expires_at")

  tenant Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch Branch          @relation(fields: [branchId], references: [id], onDelete: Cascade)
  wallet BranchSmsWallet @relation(fields: [walletId], references: [id], onDelete: Cascade)
  bundle SmsBundle       @relation(fields: [bundleId], references: [id])

  @@unique([externalTransactionId])
  @@index([tenantId, branchId, status])
  @@index([pesapalOrderTrackingId])
  @@index([branchId, bundleId, initiatedByUserId, status, createdAt])
  @@map("sms_purchases")
}

