/// Draft/working reconciliation for a branch operating day.
///
/// This must remain separate from BranchDailyOperation.closingBalance.
/// countedCash may be changed multiple times while the manager is reconciling.
/// closingBalance is only persisted when the day is finally closed.
model BranchOperationReconciliation {
  id          String @id @default(uuid()) @db.Uuid
  tenantId    String @map("tenant_id") @db.Uuid
  branchId    String @map("branch_id") @db.Uuid
  operationId String @unique @map("operation_id") @db.Uuid

  countedCash Decimal? @map("counted_cash") @db.Decimal(18, 2)
  notes       String?

  startedAt       DateTime @default(now()) @map("started_at")
  startedByUserId String   @map("started_by_user_id") @db.Uuid

  updatedByUserId String? @map("updated_by_user_id") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  tenant    Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch    Branch               @relation(fields: [branchId], references: [id], onDelete: Cascade)
  operation BranchDailyOperation @relation(fields: [operationId], references: [id], onDelete: Cascade)

  startedBy User  @relation("BranchOperationReconciliationStartedBy", fields: [startedByUserId], references: [id])
  updatedBy User? @relation("BranchOperationReconciliationUpdatedBy", fields: [updatedByUserId], references: [id])

  cashCounts BranchOperationCashCount[]

  @@index([tenantId, branchId])
  @@index([tenantId, updatedAt])
  @@map("branch_operation_reconciliations")
}

/// Immutable history of physical cash counts made during reconciliation.
///
/// Existing records must not be modified.
/// Every corrected physical cash count creates another row.
model BranchOperationCashCount {
  id               String @id @default(uuid()) @db.Uuid
  tenantId         String @map("tenant_id") @db.Uuid
  reconciliationId String @map("reconciliation_id") @db.Uuid

  previousAmount Decimal? @map("previous_amount") @db.Decimal(18, 2)
  countedAmount  Decimal  @map("counted_amount") @db.Decimal(18, 2)

  recordedAt       DateTime @default(now()) @map("recorded_at")
  recordedByUserId String   @map("recorded_by_user_id") @db.Uuid

  tenant         Tenant                        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  reconciliation BranchOperationReconciliation @relation(fields: [reconciliationId], references: [id], onDelete: Cascade)
  recordedBy     User                          @relation("BranchOperationCashCountRecordedBy", fields: [recordedByUserId], references: [id])

  @@index([tenantId, reconciliationId, recordedAt])
  @@map("branch_operation_cash_counts")
}

