  updatedAt         DateTime @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch Branch @relation(fields: [branchId], references: [id], onDelete: Cascade)

  payments            SmsCreditPayment[]
  usageLogs           SmsUsageLog[]
  purchases           SmsPurchase[]
  ledgerEntries       SmsWalletLedger[]
  messages            SmsMessage[]
  providerRequestLogs SmsProviderRequestLog[]

  @@index([tenantId])
  @@map("branch_sms_wallets")
}

