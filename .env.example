NODE_ENV=development

# API
PORT=4000
HOST=0.0.0.0
CORS_ORIGIN=http://localhost:3000
# Public web origin used in invitation / email links (no trailing slash).
# Production: https://rembeh.antikra.com
# Aliases also accepted: APP_WEB_URL, FRONTEND_URL
WEB_APP_URL=http://localhost:3000
JWT_ACCESS_SECRET=change-me-access
JWT_REFRESH_SECRET=change-me-refresh
# Local development only. Keep false or unset outside trusted dev machines.
AUTH_PHONE_OTP_DEV_MODE=true
OTP_EMAIL_FROM=auth@antikra.com
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_MAX_RESENDS=3

# Google / Microsoft OAuth (web sign-in & sign-up).
# Redirect URIs (must match IdP console exactly):
#   {API_PUBLIC_URL}/api/v1/auth/oauth/google/callback
#   {API_PUBLIC_URL}/api/v1/auth/oauth/microsoft/callback
# Local example: http://localhost:4000/api/v1/auth/oauth/google/callback
# Prod example:  https://rembeh-api.antikra.com/api/v1/auth/oauth/google/callback
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
MICROSOFT_OAUTH_CLIENT_ID=
MICROSOFT_OAUTH_CLIENT_SECRET=
# Azure AD tenant: common | organizations | consumers | or a directory GUID
MICROSOFT_OAUTH_TENANT=common
# Optional dedicated HMAC secret for OAuth state/onboarding tokens (falls back to JWT_ACCESS_SECRET)
# OAUTH_STATE_SECRET=

# Data services
# Local Docker Postgres by default. Production will use AWS RDS.
DATABASE_URL=postgresql://rembeh:rembeh@localhost:5432/rembeh?schema=public
REDIS_URL=redis://localhost:6379
# Object storage: leave S3_ENDPOINT empty for real AWS S3.
# Local MinIO example:
#   S3_ENDPOINT=http://localhost:9000
#   S3_PUBLIC_ENDPOINT=http://192.168.x.x:9000
#   S3_BUCKET=rembeh-local
S3_ENDPOINT=
S3_PUBLIC_ENDPOINT=
S3_BUCKET=rembeh-prod-bucket
# Local/dev only. On EC2 leave blank — use IAM instance role (see scripts/aws/).
S3_ACCESS_KEY=
S3_SECRET_KEY=
# Prefer same region as RDS (e.g. eu-north-1) for lower latency.
S3_REGION=eu-north-1
# Production:
# - API: EC2 + IAM role for S3 (no secret keys)
# - Database: RDS (SECURITY GROUP allows EC2 → 5432)
# - Web: Amplify / CloudFront
# - Mobile: release → EC2 API; debug → local API (auto)

# Smile ID (NIN / Enhanced KYC). When unset or SMILE_ID_ENABLED=false, API uses a local stub.
SMILE_ID_ENABLED=false
SMILE_ID_PARTNER_ID=
SMILE_ID_API_KEY=
SMILE_ID_BASE_URL=https://api.smileidentity.com/v1
SMILE_ID_CALLBACK_URL=

# Realtime (Socket.IO)
REALTIME_CORS_ORIGIN=*

# Notifications (see docs/email-deliverability.md)
EMAIL_FROM=auth@antikra.com
EMAIL_FROM_NAME=REMBEH
RESEND_API_KEY=
# SMS: mock (logs only) | pahappa | twilio | africastalking
# When keys are missing, SMS falls back to mock/log even if provider is set.
# Pahappa = EgoSMS (https://www.egosms.co) — recommended for Uganda.
SMS_PROVIDER=mock
PAHAPPA_USERNAME=
# Use PAHAPPA_API_KEY if your EgoSMS dashboard shows an API key; otherwise password.
PAHAPPA_API_KEY=
PAHAPPA_PASSWORD=
PAHAPPA_SENDER=REMBEH
# Production EgoSMS/Pahappa JSON endpoint (same as Carmie). Leave blank to use default.
# Default live: https://comms.egosms.co/api/v1/json/
# Sandbox: http://sandbox.egosms.co/api/v1/json/
PAHAPPA_BASE_URL=
PAHAPPA_SANDBOX=false
PAHAPPA_PRIORITY=0
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
AFRICASTALKING_USERNAME=
AFRICASTALKING_API_KEY=
AFRICASTALKING_FROM=
WHATSAPP_PROVIDER=mock

# Firebase Cloud Messaging (push). See docs/firebase-push.md
# Web client (public) — rembeh-web project
NEXT_PUBLIC_FIREBASE_API_KEY=AIzaSyB69EaN5m3CWK1VtF-3zMey-lVDuSfJ6GY
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=rembeh-web.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=rembeh-web
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=rembeh-web.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=110942121490
NEXT_PUBLIC_FIREBASE_APP_ID=1:110942121490:web:80fddd27aafd357a62b2cb
# Web Push certificate key pair from Firebase Console → rembeh-web → Cloud Messaging
NEXT_PUBLIC_FIREBASE_VAPID_KEY=
FIREBASE_WEB_VAPID_KEY=
# Server send — prefer PATH to downloaded Admin SDK JSON (gitignored), or JSON string
FIREBASE_WEB_SERVICE_ACCOUNT_PATH=../../apps/web/rembeh-web-firebase-adminsdk-fbsvc-XXXX.json
FIREBASE_MOBILE_SERVICE_ACCOUNT_PATH=../../apps/mobile/rembeh-mobile-firebase-adminsdk-fbsvc-XXXX.json
FIREBASE_WEB_SERVICE_ACCOUNT_JSON=
FIREBASE_MOBILE_SERVICE_ACCOUNT_JSON=
# Optional fallback if you use a single project
FIREBASE_SERVICE_ACCOUNT_PATH=
FIREBASE_SERVICE_ACCOUNT_JSON=

# Flutterwave (server-side only). Never put FLW_SECRET_KEY in web/mobile clients.
# Webhook URL: https://<api-host>/payments/flutterwave/webhook
# Dashboard → Settings → Webhooks → set Secret Hash to FLW_SECRET_HASH
FLW_ENABLED=false
FLW_PUBLIC_KEY=
FLW_SECRET_KEY=
FLW_SECRET_HASH=
FLW_DEFAULT_CURRENCY=UGX
FLW_REDIRECT_URL=
FLW_BASE_URL=https://api.flutterwave.com/v3

# Pesapal API 3.0 — branch Pro subscriptions.
# Current merchant default limit on this account is UGX 30,000 (probed live).
# Raise with Pesapal support before restoring UGX 150,000 product price.
# Sandbox: https://cybqa.pesapal.com/pesapalv3  |  Live: https://pay.pesapal.com/v3
# Production IPN (GET):  https://rembeh-api.antikra.com/api/v1/billing/pesapal/ipn
# Production callback:   https://rembeh-api.antikra.com/api/v1/billing/pesapal/callback
# Never commit real consumer key/secret — paste into server .env only.
PESAPAL_CONSUMER_KEY=
PESAPAL_CONSUMER_SECRET=
PESAPAL_ENV=sandbox
# Optional: pre-registered IPN id from Pesapal dashboard. If empty, API registers IPN on first checkout.
PESAPAL_IPN_NOTIFICATION_ID=
PESAPAL_IPN_URL=https://rembeh-api.antikra.com/api/v1/billing/pesapal/ipn
PESAPAL_CALLBACK_URL=https://rembeh-api.antikra.com/api/v1/billing/pesapal/callback
# Public API origin (optional fallback when building callback URLs locally)
# Production: https://rembeh-api.antikra.com
API_PUBLIC_URL=http://localhost:4000

# Overdue fines cron (Nest @Cron EVERY_DAY_AT_1AM).
# Timezone: set CRON_TZ or TZ (e.g. Africa/Kampala). Host local if unset.
# LOAN_FINES_CRON_ENABLED=false disables the daily job (manual POST still works).
CRON_TZ=Africa/Kampala
LOAN_FINES_CRON_ENABLED=true
